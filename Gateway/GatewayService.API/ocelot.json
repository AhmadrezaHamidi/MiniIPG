{
    "Routes": [
        // ====================== Authentication Service (Identity) ======================
        {
            "DownstreamPathTemplate": "/{everything}",
            "DownstreamScheme": "http",
            "DownstreamHostAndPorts": [
                {
                    "Host": "localhost",
                    "Port": 5284
                }
            ],
            "UpstreamPathTemplate": "/auth/{everything}",
            "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ],
            "Priority": 1,
            "Key": "auth"
        },

        // endpointهای خاص Identity که AllowAnonymous هستن و بهتره مستقیم بدون پیشوند زیاد در دسترس باشن
        // مثلاً کلاینت‌ها معمولاً به /api/login و /api/register کال می‌زنن
        {
            "DownstreamPathTemplate": "/api/user/login",
            "DownstreamScheme": "http",
            "DownstreamHostAndPorts": [
                {
                    "Host": "localhost",
                    "Port": 5284
                }
            ],
            "UpstreamPathTemplate": "/api/login",
            "UpstreamHttpMethod": [ "GET" ],
            "AuthenticationOptions": {
                "AuthenticationProviderKey": "None"
            }
        },
        {
            "DownstreamPathTemplate": "/api/user/register",
            "DownstreamScheme": "http",
            "DownstreamHostAndPorts": [
                {
                    "Host": "localhost",
                    "Port": 5284
                }
            ],
            "UpstreamPathTemplate": "/api/register",
            "UpstreamHttpMethod": [ "POST" ]
        },
        {
            "DownstreamPathTemplate": "/api/user/refresh-token",
            "DownstreamScheme": "http",
            "DownstreamHostAndPorts": [
                {
                    "Host": "localhost",
                    "Port": 5284
                }
            ],
            "UpstreamPathTemplate": "/api/refresh-token",
            "UpstreamHttpMethod": [ "GET" ]
        },

        // ====================== Payment Service ======================
        {
            "DownstreamPathTemplate": "/{everything}",
            "DownstreamScheme": "http",
            "DownstreamHostAndPorts": [
                {
                    "Host": "localhost",
                    "Port": 5001
                }
            ],
            "UpstreamPathTemplate": "/payment/{everything}",
            "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ],
            "Priority": 1,
            "Key": "payment"
        },

        // اگر بخوای endpointهای پرداخت رو با پیشوند کوتاه‌تر بزنی (اختیاری)
        {
            "DownstreamPathTemplate": "/get-token",
            "DownstreamScheme": "http",
            "DownstreamHostAndPorts": [
                {
                    "Host": "localhost",
                    "Port": 5001
                }
            ],
            "UpstreamPathTemplate": "/api/payment/get-token",
            "UpstreamHttpMethod": [ "POST" ]
        },
        {
            "DownstreamPathTemplate": "/verify",
            "DownstreamScheme": "http",
            "DownstreamHostAndPorts": [
                {
                    "Host": "localhost",
                    "Port": 5001
                }
            ],
            "UpstreamPathTemplate": "/api/payment/verify",
            "UpstreamHttpMethod": [ "POST" ]
        },
        {
            "DownstreamPathTemplate": "/update-status",
            "DownstreamScheme": "http",
            "DownstreamHostAndPorts": [
                {
                    "Host": "localhost",
                    "Port": 5001
                }
            ],
            "UpstreamPathTemplate": "/api/payment/update-status",
            "UpstreamHttpMethod": [ "POST" ]
        }
    ],

    "GlobalConfiguration": {
        "BaseUrl": "http://localhost:7000",
        "RequestIdKey": null,
        "ServiceDiscoveryProvider": {
            "Scheme": "http",
            "Host": "localhost",
            "Port": 8500,
            "Type": "Consul" // اگر بعداً Consul استفاده کردی، در حال حاضر می‌تونی حذف کنی
        }
    }
}